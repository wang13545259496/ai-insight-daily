{
  "name": "ai-news-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "news:content": "tsx scripts/fillNewsContent.ts",
    "news:analysis": "tsx scripts/generateNewsAnalysis.ts",
    "build": "next build --webpack",
    "event:summary": "tsx scripts/rebuildEventSummary.ts",
    "start": "next start -H 0.0.0.0",
    "cluster:event": "tsx scripts/build-events.ts",
    "link:event": "tsx scripts/link-events.ts",
    "pipeline:news": "tsx scripts/run-pipeline.ts",
    "rss:health": "tsx scripts/rss/healthCheck.ts",
    "rss:scheduler": "tsx scripts/rss/runScheduler.ts",
    "industry:hotspot": "tsx scripts/analyzeIndustryHotspots.ts",
    "industry:trend": "tsx scripts/saveIndustryTrend.ts",
    "briefing:create": "tsx scripts/createDailyBriefing.ts",
    "rss:fusion": "tsx scripts/rss/fusion.ts",
    "lint": "eslint .",
    "seed": "tsx scripts/seed.ts",
    "daily": "tsx scripts/daily.ts",
    "seed:sources": "tsx scripts/seedSources.ts",
    "seed:investment": "tsx prisma/seedInvestment.ts",
    "fix:news": "tsx scripts/fixNewsSource.ts",
