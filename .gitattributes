# 统一换行符：仓库内一律以 LF 存储，检出到工作区时按平台转换
* text=auto eol=lf

# Windows 批处理与 PowerShell 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.db binary

# 锁文件不要参与 diff 统计
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff
