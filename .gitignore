# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===== database =====
# 本地 SQLite 数据库不纳入版本控制
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
/prisma/migrations/dev.db*

# ===== 本地工具产物 =====
/.agents/
/.claude/
/.cursor/
/.devin/
# ===== server backup =====
/backup/

# 本地备份目录（不入库）
_backup/

# 改动前的临时备份（不应进入版本控制）
*.before-*
*.bak

# 运行日志（由服务与定时任务生成，不入库）
logs/

# 交接包暂存目录（由 update-ai-handover.sh 每次重建，不入库）
AI-HANDOVER/

# 重新分析的旧值备份（临时，不入库）
backup/reanalysis/
backup/entity-extract-progress.json
