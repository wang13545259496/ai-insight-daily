generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Source {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  url               String
  rssUrl            String?
  type              String    @default("rss")
  status            String    @default("active")
  enabled           Boolean   @default(true)
  errorCount        Int       @default(0)
  lastFetch         DateTime?
  rssStatus         String    @default("unknown")
  rssScore          Int       @default(0)
  rssFailCount      Int       @default(0)
  rssEnabled        Boolean   @default(true)
  rssWeight         Int       @default(100)
  rssSuccessCount   Int       @default(0)
  rssTotalCount     Int       @default(0)
  rssPausedAt       DateTime?
  lastCheckTime     DateTime?
  lastResponseTime  Int?
  lastError         String?
  lastCollectTime   DateTime?
  nextCollectTime   DateTime?
  collectCount      Int       @default(0)
  collectErrorCount Int       @default(0)
  lastCollectError  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  news              News[]
  RSSLog            RSSLog[]
}

model News {
  id Int @id @default(autoincrement())

  // ==============================
  // 基础新闻信息
  // ==============================

  title String

  // 中文标题：英文来源（OpenAI 博客、TechCrunch 等）由模型生成中文标题后写入
  // 页面优先显示本字段，为空时回退到 title。arXiv 论文不生成。
  titleZh String?

  category String

  // 新闻背景

  background String?

  // AI摘要

  summary String

  // 新闻正文

  content String

  // 新闻来源

  source String

  sourceUrl String?

  publishedAt DateTime?

  // 是否验证

  verified Boolean @default(false)

  // ==============================
  // 新闻质量状态
  // V7.4.8.10.5.5.8.6.7.1
  // ==============================

  // active
  // repair
  // archived

  dataStatus String @default("active")

  // 数据清洗原因

  cleanReason String?

  // ==============================
  // 多源融合
  // ==============================

  sourceCount Int @default(1)

  duplicateHash String? @unique

  mergedSources String?

  originalSourceCount Int @default(1)

  // ==============================
  // AI新闻价值增强系统
  // V7.4.8.10.5.5.9.2
  // ==============================

  // AI一句话洞察

  insight String?

  // 行业影响分析

  impact String?

  // 商业机会分析

  businessOpportunity String?

  // 投资观察

  investmentView String?

  // AI价值评分

  aiScore Float @default(0)

  // AI分析状态

  // pending
  // completed

  analysisStatus String @default("pending")

  // ==============================
  // 事件关联
  // ==============================

  sourceId Int?

  eventId Int?

  createdAt DateTime @default(now())

  // ==============================
  // Prisma关系
  // 注意保持单行格式
  // ==============================

  sourceRef Source? @relation(fields: [sourceId], references: [id])

  event NewsEvent? @relation(fields: [eventId], references: [id])

  investmentSources Investment[] @relation("InvestmentSourceNews")

  /** 该新闻提及的实体 */
  entities NewsEntity[]
}

model DailyReport {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  date      String   @unique
  createdAt DateTime @default(now())
}

model BusinessOpportunity {
  id             Int              @id @default(autoincrement())
  industry       String
  opportunity    String
  trend          String
  direction      String
  description    String
  createdAt      DateTime         @default(now())
  BusinessReport BusinessReport[]
}

model BusinessReport {
  id                  Int                 @id @default(autoincrement())
  businessId          Int
  marketAnalysis      String
  painPoints          String
  aiSolution          String
  productDesign       String
  businessModel       String
  riskAnalysis        String
  startupAdvice       String
  createdAt           DateTime            @default(now())
  BusinessOpportunity BusinessOpportunity @relation(fields: [businessId], references: [id])
}

model Investment {
  id          Int    @id @default(autoincrement())
  name        String
  industry    String
  description String

  businessScore   Int
  technologyScore Int
  marketScore     Int
  growthScore     Int
  riskScore       Int

  // ==============================
  // 投资来源证据链
  // ==============================

  sourceNewsId  Int?
  sourceEventId Int?

  // company / startup / platform /
  // infrastructure / theme
  sourceType String?

  // 说明为什么进入投资候选
  sourceReason String?

  createdAt DateTime @default(now())

  sourceNews  News?      @relation("InvestmentSourceNews", fields: [sourceNewsId], references: [id], onDelete: SetNull)
  sourceEvent NewsEvent? @relation("InvestmentSourceEvent", fields: [sourceEventId], references: [id], onDelete: SetNull)

  InvestmentFavorite InvestmentFavorite[]
  InvestmentScore    InvestmentScore[]

  @@index([sourceNewsId])
  @@index([sourceEventId])
}

model InvestmentFavorite {
  id           Int        @id @default(autoincrement())
  investmentId Int
  createdAt    DateTime   @default(now())
  Investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model InvestmentScore {
  id           Int        @id @default(autoincrement())
  investmentId Int
  total        Int
  level        String
  createdAt    DateTime   @default(now())
  Investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
}

model RSSLog {
  id           Int      @id @default(autoincrement())
  sourceId     Int
  status       String
  newsCount    Int      @default(0)
  duration     Int?
  errorMessage String?
  createdAt    DateTime @default(now())
  Source       Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model NewsEvent {
  id Int @id @default(autoincrement())

  title String

  // 中文标题：事件标题取首条新闻的标题，可能是英文。
  // 由模型生成中文后写入，页面优先显示本字段，为空时回退到 title。
  titleZh String?

  keywords String

  summary String

  category String

  // 当前热度
  heatScore Float @default(0)

  // 峰值热度
  peakScore Float @default(0)

  // 趋势状态
  trendStatus String @default("rising")

  // AI分析
  trendSummary String?

  // 状态
  status String @default("active")

  // ======================
  // V7.4.8.10.5.5.8.6.7.3.7.1
  // 事件质量分类
  // ======================

  eventType String @default("unknown")

  qualityScore Float @default(0)

  // 产业价值分：首页今日重点排序依据
  // 热度 + 企业权重 + 商业价值 + 投资价值 - 学术噪声
  industryScore Float @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now())

  news News[]

  investmentSources Investment[] @relation("InvestmentSourceEvent")

  /** 该事件涉及的实体 */
  entities EventEntity[]
}

model IndustryHotspot {
  id Int @id @default(autoincrement())

  name String @unique

  category String

  keywords String

  score Int @default(0)

  trend String @default("stable")

  newsCount Int @default(0)

  recentNewsCount Int @default(0)

  eventCount Int @default(0)

  companyScore Int @default(0)

  description String?

  trends IndustryTrend[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model IndustryTrend {
  id Int @id @default(autoincrement())

  hotspotId Int

  date DateTime @default(now())

  score Int

  hotspot IndustryHotspot @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

// ==============================
// 旅行规划方案
//
// 存整份方案的 JSON + 少量用于列表展示与检索的标量列。
// 之所以不做成多张表（行程日、活动各一张）：方案是一次生成、整体
// 读取的整体对象，没有按单日查询的需求，拆表只会增加读写成本。
// ==============================

model TripPlan {

  id Int @id @default(autoincrement())

  // ---------- 需求摘要（用于列表展示与检索）----------

  origin String

  destination String

  departDate String

  returnDate String

  adults Int @default(1)

  children Int @default(0)

  // 总预算（人民币元）
  budget Int

  // 预算档位：budget / comfort / premium / luxury
  style String @default("comfort")

  // 偏好标签，逗号分隔存储
  interests String?

  // ---------- 方案正文 ----------

  // 完整 TravelPlan 的 JSON 字符串
  planJson String

  // 一段话总览，列表页直接展示，避免解析整份 JSON
  overview String

  // 交通与住宿报价来源：live（全部真实）/ partial（部分真实）/ estimate（全为估算）
  quoteMode String @default("estimate")

  // 行程内容是否由模型生成
  generatedByAI Boolean @default(false)

  // 生成所用模型
  model String?

  // 需求指纹：同一需求重复提交时用于去重
  fingerprint String?

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  // 历史列表按时间倒序
  @@index([createdAt])

  // 按目的地筛选历史方案
  @@index([destination, createdAt])

  // 同一需求只保留一条方案
  @@unique([fingerprint])

}

// ==============================================================
// 实体关联（2026-10-16 新增）
//
// 用途：把「公司 / 模型 / 产品 / 人物」从新闻与事件里抽出来，
// 建立可反向查询的关联，支撑两个此前缺失的能力：
//   · 企业关联 —— 某个公司/模型的全部相关动态
//   · 趋势判断 —— 同一实体在时间轴上的变化
//
// 为什么不复用 IndustryHotspot：
//   那是**主题**级分类（AI大模型 / AI芯片 / AI智能体，共 5 条），
//   属于话题标签；这里需要的是**具体实体**（OpenAI、GPT-6、Claude），
//   两者粒度不同，合并会导致话题与实体混淆。
//
// 为什么不复用 NewsEvent.keywords：
//   实测该字段的中文抽取是逐字滑窗（「新晋,晋顶,顶流,流当,当大,大模」），
//   是噪声而非词，不可用。
// ==============================================================

model Entity {
  id Int @id @default(autoincrement())

  /** 规范名，如 OpenAI、GPT-6、Claude */
  name String

  /** company | model | product | person */
  type String

  /**
   * 别名，用 | 分隔，且首尾也带分隔符。
   *
   * 首尾加分隔符是为了让匹配用「包含 |别名| 」而非简单子串 ——
   * 否则别名 Apple 会命中正文里的 Appleby。
   */
  aliases String @default("|")

  /** 一句话说明这个实体是什么，用于页面展示 */
  description String?

  /** active | candidate | merged —— 抽取结果先进 candidate 待核 */
  status String @default("candidate")

  /** 被合并到哪个实体（合并同义实体时保留指向，便于追溯） */
  mergedIntoId Int?

  /** 统计字段，由刷新任务维护，便于列表页排序而无需实时聚合 */
  newsCount  Int @default(0)
  eventCount Int @default(0)

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  /** 同一类型下名称唯一；不同类型允许重名（如 Apple 公司 vs Apple 产品线） */
  /** 该实体关联的新闻（反向） */
  newsEntities NewsEntity[]

  /** 该实体关联的事件（反向） */
  eventEntities EventEntity[]

  @@unique([name, type])
  @@index([status])
  @@index([type])
  @@index([newsCount])
}

model NewsEntity {
  id Int @id @default(autoincrement())

  newsId   Int
  entityId Int

  /** 该实体在这篇新闻里出现的次数，用于判断关联强度 */
  mentions Int @default(1)

  /** subject | object | background —— 实体在叙述中的角色 */
  role String @default("background")

  createdAt DateTime @default(now())

  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([newsId, entityId])
  @@index([entityId])
}

model EventEntity {
  id Int @id @default(autoincrement())

  eventId  Int
  entityId Int

  /** 是否为该事件的主体实体（用于事件卡片的「涉及公司」展示） */
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  event  NewsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([eventId, entityId])
  @@index([entityId])
}
